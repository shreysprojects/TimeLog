{
  "expo": {
    "name": "TimeLog",
    "slug": "timelog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "timelog",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "ios"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shreyj.timelog"
    },
    "android": {
      "package": "com.shreyj.timelog",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2b7fff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a92b603-5b1d-474f-9522-811d36faf62c"
      }
    },
    "owner": "shreyj7",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9a92b603-5b1d-474f-9522-811d36faf62c"
    }
  }
}
